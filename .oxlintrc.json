{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // NOTE on the `Date.now()` ban (see README 現状 / scripts/check-dependency-whitelist.ts):
  // oxlint 0.12 does not implement `no-restricted-syntax` or `no-restricted-properties`,
  // and while `no-restricted-globals` is listed by `oxlint --rules` it is not implemented
  // either (no checkmark). Verified empirically against oxlint 0.12.0: a file containing
  // `Date.now()` produces 0 diagnostics under all three rules. The ban is therefore
  // enforced by `pnpm check:deps` (scripts/check-dependency-whitelist.ts) instead.
  // When oxlint gains `no-restricted-syntax`, move the ban here and delete the script's
  // time-source section.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "5.9"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    // Exception in this repo: the plan.md §4.1 contracts (StageRegistration, GameModule)
    // are reproduced verbatim as `interface` so the spec and the code read identically.
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    // NOTE on the pure-formatting rules previously listed here (array-bracket-spacing,
    // block-spacing, brace-style, camelcase, comma-dangle, comma-spacing, comma-style,
    // computed-property-spacing, eol-last, func-call-spacing, indent, key-spacing,
    // keyword-spacing, linebreak-style, lines-between-class-members, no-mixed-spaces-and-tabs,
    // no-new-object, no-tabs, no-trailing-spaces, no-whitespace-before-property,
    // object-curly-spacing, one-var, operator-linebreak, padded-blocks, quote-props,
    // semi-spacing, space-before-blocks, space-infix-ops, space-unary-ops, spaced-comment):
    // this file was never actually loaded by oxlint before this fix (oxlint only
    // auto-discovers `.oxlintrc.json`, not `oxlint.json`), so nobody noticed that oxlint
    // 1.76.0 has removed all of these from its `eslint` plugin rule set entirely (verified
    // empirically: `oxlint --rules --format=json` on 1.76.0 lists 847 rules total and none
    // of the names above appear under any plugin/scope). Loading the config with any of
    // them present is a hard parse error ("Rule 'x' not found in plugin 'eslint'"), not a
    // warning, so they have been deleted rather than carried forward. There is still no
    // prettier/biome/.editorconfig in this repo; formatting is presently unenforced.
    "no-array-method-this-argument": "warn",
    "no-bitwise": "warn",

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Declared for intent and for the day oxlint implements it; inert in 0.12.
    // The real enforcement lives in scripts/check-dependency-whitelist.ts.
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    "no-restricted-imports": [
      "warn",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        "patterns": [
          {
            "regex": "^@nerima-games/(mx-gameplay|mx-ui|mx-multiplayer)(/.*)?$",
            "message": "Tier3 experience modules do not depend on each other laterally (DEPENDENCY_POLICY.md §2). Talk through mc-sim or mc-worldgen instead."
          },
          {
            "regex": "^@nerima-games/(mc-audio|mc-meshing|mc-noise|mc-physics|mc-save|mc-render|mc-playground-kit|mc-compose|mc-dev-meta)(/.*)?$",
            "message": "mx-redstone (Tier3, DEPENDENCY_POLICY.md) may depend only on mc-sim, mc-worldgen, and mc-kernel (universally importable). mc-playground-kit may only ever be a devDependency, taken from test/ or scripts/, never from shipped src/."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
