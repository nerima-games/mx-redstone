{
  "name": "@nerima-games/mx-redstone",
  "version": "0.3.3",
  "type": "module",
  "description": "Experience module for the nerima-games Minecraft-clone rebuild: the redstone mechanism — wire power propagation, torches, levers, buttons, repeaters and piston pushing.",
  "homepage": "https://github.com/nerima-games/mx-redstone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mx-redstone.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mx-redstone/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "redstone"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test apps && ast-grep scan",
    "lint:fix": "oxlint --fix src scripts test apps",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify",
    "preview": "tsx apps/preview-circuit-board/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.7.0",
    "@nerima-games/mc-sim": "0.4.2",
    "@nerima-games/mc-worldgen": "0.3.2",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/vitest": "0.30.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "knip": "6.33.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
